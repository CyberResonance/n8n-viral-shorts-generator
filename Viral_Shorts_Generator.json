{
  "name": "Viral Shorts Generator",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Test (dry run)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1300,
        -100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "viral-short",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook (POST /viral-short)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1300,
        100
      ],
      "webhookId": "viral-short"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the request. dryRun defaults to TRUE: video rendering costs money and must be asked for explicitly.\nconst b = $input.first().json.body || {};\nconst clamp = (v, lo, hi, d) => Math.min(hi, Math.max(lo, Number(v) || d));\nreturn [{ json: {\n  topic: String(b.topic || '3 automation habits that save a freelancer 5 hours a week').slice(0, 300),\n  audience: String(b.audience || 'freelancers and small business owners').slice(0, 200),\n  style: String(b.style || 'clean modern motion graphics, bold colors, cinematic lighting').slice(0, 200),\n  language: String(b.language || 'English').slice(0, 30),\n  seconds: clamp(b.seconds, 4, 10, 8),\n  dryRun: b.dryRun === false || b.dryRun === 'false' ? false : true,\n} }];"
      },
      "name": "Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1080,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst prompt = `You are a short-form video strategist (YouTube Shorts, Instagram Reels).\nCreate ONE vertical 9:16 short about: ${j.topic}\nAudience: ${j.audience}. Visual style: ${j.style}. Language for title, hook and caption: ${j.language}.\nThe clip is ONE continuous ${j.seconds}-second shot generated by a video model, so the visual must work without cuts.\nRules: hook must create curiosity in the first 2 seconds; no real people, celebrities, logos, brands or copyrighted characters;\nsafe for work; no medical, financial or legal promises; no text rendered inside the video.\nReturn JSON only:\n{\"title\": \"max 70 chars\", \"hook\": \"on-screen hook, max 60 chars\", \"video_prompt\": \"detailed visual description of the single shot: subject, motion, camera move, lighting, ambience/music, no dialogue\",\n \"caption\": \"max 300 chars, ends with a question or call to action\", \"hashtags\": [\"3-5 tags without #\"]}`;\nreturn [{ json: { ...j, requestBody: { contents: [{ parts: [{ text: prompt }] }], generationConfig: { temperature: 0.9, responseMimeType: 'application/json' } } } }];"
      },
      "name": "Build Concept Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Gemini: Concept",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        0
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Gemini API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Validate the concept and build the video request.\nconst brief = $('Brief').first().json;\nlet s = {};\ntry { s = JSON.parse($input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '{}'); } catch (e) { s = {}; }\nif (!s.video_prompt) throw new Error('Gemini returned no video_prompt: ' + JSON.stringify(s).slice(0, 300));\nconst tags = (Array.isArray(s.hashtags) ? s.hashtags : []).map(t => '#' + String(t).replace(/[^\\p{L}\\p{N}_]/gu, '')).filter(t => t.length > 1).slice(0, 5);\nconst title = String(s.title || brief.topic).slice(0, 70);\nconst caption = (String(s.caption || '').slice(0, 300) + (tags.length ? '\\n\\n' + tags.join(' ') : '')).trim();\nconst slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 50) || 'short';\nconst videoPrompt = `Continuous single shot, vertical 9:16, about ${brief.seconds} seconds, no dialogue, no on-screen text. ${s.video_prompt} Style: ${brief.style}. Safe for work, no real people, no logos.`;\nreturn [{ json: { dryRun: brief.dryRun, topic: brief.topic, title, hook: String(s.hook || '').slice(0, 60), caption, hashtags: tags,\n  videoPrompt, fileName: `${slug}.mp4`,\n  omniRequest: { model: 'gemini-omni-1.1-flash', input: videoPrompt, response_format: { type: 'video', aspect_ratio: '9:16', resolution: '720p', delivery: 'uri' }, store: true } } }];"
      },
      "name": "Parse Concept",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, rendering: !$json.dryRun, title: $json.title, hook: $json.hook, caption: $json.caption, videoPrompt: $json.videoPrompt }) }}",
        "options": {}
      },
      "name": "Respond: Concept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.dryRun === false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Render Video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.omniRequest) }}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Omni: Start Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -100
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Gemini API"
        }
      },
      "notes": "Paid: roughly $0.10 per second of video."
    },
    {
      "parameters": {
        "jsCode": "// Find the video file in the Omni response; the poll step checks the file state until it is ACTIVE.\nconst r = $input.first().json;\nconst uri = (r.steps || []).flatMap(s => s.content || []).find(c => c.type === 'video')?.uri || '';\nconst fileId = (uri.split('/files/')[1] || '').split(':')[0].split('?')[0];\nif (!fileId) throw new Error('Omni returned no video file: ' + JSON.stringify(r.error || r).slice(0, 400));\nreturn [{ json: { videoUri: uri, fileId } }];"
      },
      "name": "Video Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -100
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        680,
        -100
      ],
      "webhookId": "viral-short-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/files/' + $('Video Job').first().json.fileId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "options": {}
      },
      "name": "Omni: Poll File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -100
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Gemini API"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.state === 'ACTIVE' }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Ready"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.state === 'PROCESSING' && $runIndex < 30 }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Keep waiting"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Failed"
        }
      },
      "name": "Video Ready?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1120,
        -100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Video Job').first().json.videoUri }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 120000
        }
      },
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        -200
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Gemini API"
        }
      }
    },
    {
      "parameters": {
        "name": "={{ $('Parse Concept').first().json.fileName }}",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "YOUR_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "options": {}
      },
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1560,
        -200
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Message for the review channel.\nconst s = $('Parse Concept').first().json;\nconst up = $input.first().json;\nconst link = up.webViewLink || (up.id ? `https://drive.google.com/file/d/${up.id}/view` : '(upload failed)');\nconst content = [`🎬 **New short ready for review:** ${s.title}`, `**Hook:** ${s.hook}`, `**Caption:**\\n${s.caption}`, `**Video:** ${link}`,\n  'Review it, then post it yourself or approve it in your publishing queue.'].join('\\n\\n').slice(0, 1990);\nreturn [{ json: { content, link, title: s.title } }];"
      },
      "name": "Build Review Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -200
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "guildId": {
          "__rl": true,
          "value": "YOUR_DISCORD_SERVER_ID",
          "mode": "id"
        },
        "channelId": {
          "__rl": true,
          "value": "YOUR_DISCORD_CHANNEL_ID",
          "mode": "id"
        },
        "options": {},
        "content": "={{ $json.content }}"
      },
      "name": "Discord: Review",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        2000,
        -200
      ],
      "credentials": {
        "discordOAuth2Api": {
          "id": "",
          "name": "Discord Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Video not ready: ' + JSON.stringify($json.error || $json.state || $json).slice(0, 400) }}"
      },
      "name": "Video Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1340,
        40
      ]
    }
  ],
  "connections": {
    "Manual Test (dry run)": {
      "main": [
        [
          {
            "node": "Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook (POST /viral-short)": {
      "main": [
        [
          {
            "node": "Brief",
