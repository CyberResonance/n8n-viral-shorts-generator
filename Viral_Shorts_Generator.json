            "index": 0
          }
        ]
      ]
    },
    "Upload to Google Drive": {
      "main": [
        [
          {
            "node": "Build Review Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Review Message": {
      "main": [
        [
          {
            "node": "Discord: Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}